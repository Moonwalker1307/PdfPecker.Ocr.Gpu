<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Which native ONNX Runtime to run with: Cpu (default, any machine), Gpu (CUDA) or DirectML (Windows). -->
    <OnnxRuntimeNative Condition="'$(OnnxRuntimeNative)' == ''">Cpu</OnnxRuntimeNative>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PdfPecker.Ocr.Gpu/PdfPecker.Ocr.Gpu.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(OnnxRuntimeNative)' == 'Cpu'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="$(OnnxRuntimeTestVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(OnnxRuntimeNative)' == 'Gpu'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="$(OnnxRuntimeTestVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(OnnxRuntimeNative)' == 'DirectML'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="$(OnnxRuntimeManagedVersion)" />
  </ItemGroup>

</Project>
